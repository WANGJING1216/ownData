{
  "name": "基础日记模板",
  "dimensions": [
    {
      "name": "事件",
      "fields": [
        {"name": "标题", "type": "text", "required": true},
        {"name": "日期", "type": "date"},
        {"name": "情感分", "type": "number", "min": 1, "max": 5},
        {"name": "类型", "type": "multiselect", "options": ["家庭", "工作", "学习", "社交", "健康", "娱乐"]},
        {"name": "描述", "type": "text"},
        {"name": "关键词", "type": "multiselect", "free": true},
        {"name": "是否核心", "type": "boolean"}
      ]
    },
    {
      "name": "人物",
      "fields": [
        {"name": "姓名", "type": "text", "required": true},
        {"name": "关系", "type": "select", "options": ["家人", "朋友", "同事", "恋人", "陌生人"]},
        {"name": "描述", "type": "text"}
      ]
    },
    {
      "name": "情感",
      "fields": [
        {"name": "情绪", "type": "select", "options": ["开心", "悲伤", "愤怒", "平静", "焦虑", "感恩", "期待"]},
        {"name": "强度", "type": "number", "min": 1, "max": 5},
        {"name": "触发因素", "type": "text"},
        {"name": "描述", "type": "text"}
      ]
    }
  ]
}
